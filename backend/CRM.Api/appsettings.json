{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "crm-api",
    "Audience": "crm-web",
    "ExpiryMinutes": 60,
    "Key": ""
  },
  "ConnectionStrings": {
    "CrmDb": ""
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Attachments": {
    "StorageRoot": "App_Data/attachments",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/gif",
      "text/plain",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    ],
    "AllowedExtensions": [".pdf", ".png", ".jpg", ".jpeg", ".gif", ".txt", ".doc", ".docx", ".xls", ".xlsx"]
  },
  "Sla": {
    "Enabled": true,
    "IntervalSeconds": 60
  }
}
