{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "crm-api",
    "Audience": "crm-web",
    "ExpiryMinutes": 60,
    "Key": ""
  },
  "ConnectionStrings": {
    "CrmDb": ""
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Attachments": {
    "StorageRoot": "App_Data/attachments",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/gif",
      "text/plain",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    ],
    "AllowedExtensions": [".pdf", ".png", ".jpg", ".jpeg", ".gif", ".txt", ".doc", ".docx", ".xls", ".xlsx"]
  },
  "Sla": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "Email": {
    "Provider": "Development",
    "FromAddress": "no-reply@crm.local",
    "FromName": "CRM Support"
  },
  "AI": {
    "Enabled": false,
    "Provider": "Development",
    "Model": "development-mock",
    "ApiKey": null,
    "TimeoutSeconds": 15
  }
}
